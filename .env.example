# 复制为 .env 后填入本地值；.env 已被 .gitignore 排除，禁止提交真实凭据。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_INPUT_PRICE_PER_MILLION=0
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=0

# ---- 模型网关可靠性（重试 + 熔断）----
# 只重试瞬时故障（连接失败 / 超时 / 429 / 5xx）；4xx 与空回答不重试。
MODEL_RETRY_MAX_ATTEMPTS=3
MODEL_RETRY_BASE_DELAY_SECONDS=0.5
MODEL_RETRY_BACKOFF_FACTOR=2.0
MODEL_RETRY_MAX_DELAY_SECONDS=5.0
# 熔断：同一场景连续失败 N 次后冷却 M 秒，期间直接 circuit_open 快速失败，
# 按场景隔离（聊天 / 摘要 / 意图 / 改写各一个熔断器，互不拖累）。
MODEL_BREAKER_FAILURE_THRESHOLD=3
MODEL_BREAKER_RESET_SECONDS=30.0

# 必须与 Java 侧 AI_SERVICE_TOKEN 完全一致；不能使用模型密钥代替。
AI_SERVICE_TOKEN=replace-with-a-shared-service-token

# 知识检索；本地默认值对应 scripts/ingest.py 构建出的 knowledge-v3 索引。
RAG_ENABLED=true
QDRANT_URL=http://localhost:6333
RAG_COLLECTION=orange_diary_knowledge_v4
RAG_INDEX_VERSION=knowledge-v4
RAG_TOP_K=5
# 两级证据门槛（48 题评估集实测）：相关题首位相似度最低 0.554，无关题最高 0.581，
# 单阈值分不开，因此"向量 >= 0.60"或"关键词 >= 12.0"任一成立才算有证据。
RAG_MIN_SCORE=0.60
RAG_BM25_STRONG_SCORE=12.0
RAG_MAX_PER_DOCUMENT=2

# 并发闸门与排队（M7）。rerank 是纯 CPU 操作：本机实测并发 4 时单请求 4.85s、
# 并发 2 时 2.8s，成功吞吐几乎相同。默认 2，机器更强可上调。
RAG_MAX_CONCURRENCY=2
RAG_MAX_QUEUE=8
# 拿到名额后最多等多久；超时返回 429，而不是让请求一直挂着直到 Java 侧 6s 超时。
RAG_QUEUE_WAIT_MS=2000
# 单用户 60s 内最多 10 次检索
RAG_USER_LIMIT=10
RAG_USER_WINDOW_SECONDS=60
# 跨进程总量上限：0 表示不启用（单实例部署足够）。启用需 pip install redis 并填 URL。
RAG_GLOBAL_LIMIT=0
RAG_REDIS_URL=
# 检索结果缓存：命中后跳过 Embedding + Qdrant + rerank（线上约 1.8s → 约 1ms）。
# TTL 别设太长，否则知识库更新后旧来源会继续挂着；评估脚本已强制关闭缓存。
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_MAX_ENTRIES=256
# 熔断：向量通道连续失败 N 次后冷却 M 秒，期间直接 503 快速失败，
# 不再每次空等 OLLAMA_TIMEOUT_SECONDS（8s 比 Java 侧 6s 读超时还长）。
RAG_BREAKER_FAILURE_THRESHOLD=3
RAG_BREAKER_RESET_SECONDS=30
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
# 在线检索的 Embedding 超时；离线入库脚本另有较长超时，不要再调大。
OLLAMA_TIMEOUT_SECONDS=8.0
# 模型保活：默认 5 分钟空闲就卸载，重载 bge-m3 需要 5~6s，会超过 Java 侧 6s 读超时。
OLLAMA_KEEP_ALIVE=30m

# Rerank（可选）：none = 不重排；local = 本地 cross-encoder；http = 外部 TEI 兼容服务。
# 开启 local 前先跑 scripts/fetch_reranker.py 下载模型（约 1.1GB，不进 git）。
# 阈值 0.75 由 48 题评估集扫出（0.70~0.80 是平台区），改了模型就要重新扫。
RERANK_PROVIDER=none
RERANK_MODEL_PATH=knowledge/models/bge-reranker-base
RERANK_CANDIDATES=12
RERANK_MIN_SCORE=0.75
RERANK_MAX_LENGTH=320
RERANK_BATCH_SIZE=8
# 0 = 交给 torch 默认线程数；CPU 推理时限制线程可避免与 Embedding 抢核。
RERANK_THREADS=0
# RERANK_PROVIDER=http 时使用
RERANK_URL=
RERANK_MODEL_NAME=
RERANK_TOKEN=
RERANK_TIMEOUT_SECONDS=3.0

# ---- 业务后端（M1 起 Python 承载业务，前端 /api 直连本服务）----
APP_ENV=development
# 与 Java 共用同一个 MySQL 库，切流前后都指这里；不要把测试库写进本文件。
DATABASE_URL=mysql+asyncmy://orange:change-me@127.0.0.1:3306/calorie_tracker
# 认证会话专用库；RAG 限流用的是下面的 RAG_REDIS_URL，两者互不影响。
REDIS_URL=redis://127.0.0.1:6379/0
# 必须与 Java 的 JWT_SECRET 相同（Base64 编码后的密钥）。
# 换掉它 = 所有存量 access token 立即失效，属于破坏性变更。
JWT_SECRET=
JWT_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=2592000000
# 切流后新会话写在新命名空间，旧 Java 会话不受影响；无感迁移须另做兼容测试。
AUTH_SESSION_NAMESPACE=auth:session:

# ---- 社区写操作限流（对齐 Java `community.rate-limit`）----
# 这些是安全边界：Redis 不可用时返回 503，不会放行。
COMMUNITY_POSTS_PER_HOUR=20
COMMUNITY_COMMENTS_PER_MINUTE=30
COMMUNITY_COMMENTS_PER_DAY=500
COMMUNITY_IMAGES_PER_HOUR=100
# 单位字节，默认 500MB/人/天。
COMMUNITY_IMAGE_BYTES_PER_DAY=524288000
COMMUNITY_REPORTS_PER_DAY=30

# ---- 图片对象存储（MinIO，S3 兼容；与 Java 同一套变量名）----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=orange-diary

# ---- AI 问答（`/api/ai/**`）----
# false 时三个端点直接 404（对齐 Java `features.ai-chat.enabled`）。
FEATURES_AI_CHAT_ENABLED=true
# 每人每天成功提问次数；演示日（彩排+演示+老师试）约 50 次。
AI_DAILY_QUOTA=50
# 分钟窗口只防脚本：正常对话不会一分钟连问 10 句。
AI_QUOTA_PER_MINUTE=10
# 管理员免次数、不免 token 成本；成本上限首版未落地，语义先固定。
AI_QUOTA_ADMIN_EXEMPT=true
# 会话摘要：够 50 条消息才触发，一次压 20 条，摘要上限 1200 字。
AI_SUMMARY_TRIGGER_MESSAGES=50
AI_SUMMARY_BATCH_SIZE=20
AI_SUMMARY_MAX_CHARS=1200
