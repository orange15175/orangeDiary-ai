# 本地配置与凭据
.env
.env.local

# Python 产物
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
# 覆盖率数据是本地跑测的副产物，CI 用上传的 xml 报告，不入库。
.coverage
coverage.xml
htmlcov/

# 编辑器本地文件（整个 .idea 不入库：misc.xml/iml 会随 IDE 版本漂移）
.idea/
*.iml
*.iws
.vscode/

# RAG 构建产物（可由 scripts/ingest.py 重新生成）
backend/knowledge/index/

# rerank 模型权重（约 1.1GB，由 scripts/fetch_reranker.py 下载）
backend/knowledge/models/

# 前端依赖与构建产物
node_modules/
dist/
.env.*.local

# 本地运行输出
backend/output/
*.log
